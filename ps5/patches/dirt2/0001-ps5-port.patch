 // Copies everything written to stderr (our log, fatal errors with guest
 // registers, DXVK) into <data>/dirt2.log as well: on iOS the console is gone
 // unless a debugger is attached.
 void tee_stderr(const std::string& path) {
+#if defined(__PROSPERO__)
+    // A title has no usable stderr to copy from, and the first title build left
+    // this log empty: stderr goes straight to the file, line buffered, so a
+    // crash keeps everything before it.
+    std::rename(path.c_str(), (path.substr(0, path.size() - 4) + ".prev.log").c_str());
+    if (!std::freopen(path.c_str(), "w", stderr)) {
+        ps5_mark("tee_stderr: freopen of the log failed");
+        return;
+    }
+    std::setvbuf(stderr, nullptr, _IOLBF, 0);
+    // A write to the log file freezes the game's frames for 0.2-0.9 s on the console, whichever
+    // thread makes it (measured: every stall followed a line reaching this file, also when a
+    // thread of its own wrote it). So stderr goes to a pipe, and a thread keeps what arrives
+    // in memory: it writes the file as lines come for the first 30 s (start-up problems), then
+    // every 30 s, and at once when a crash or fatal error is reported (which then sleeps before
+    // exiting). A title closed from the console's menu loses up to its last 30 s of log.
+    {
+        const int fd = fileno(stderr);
+        const int file = dup(fd);
+        int fds[2];
+        if (file < 0 || pipe(fds) != 0) {
+            ps5_mark("tee_stderr: no pipe; the log is written directly");
+            return;
+        }
+        dup2(fds[1], fd);
+        close(fds[1]);
+        static int copy_fds[2];
+        copy_fds[0] = fds[0];
+        copy_fds[1] = file;
+        pthread_t writer;
+        const int rc = pthread_create(&writer, nullptr, [](void*) -> void* {
+            static char buf[65536];
+            std::string held;
+            const auto start = std::chrono::steady_clock::now();
+            auto last_write = start;
+            bool urgent = false;
+            for (;;) {
+                const ssize_t n = read(copy_fds[0], buf, sizeof buf);
+                if (n <= 0) break;
+                held.append(buf, size_t(n));
+                urgent = urgent || held.find("CRASH") != std::string::npos || held.find("quitting (") != std::string::npos || held.find("ExitProcess(") != std::string::npos || held.find("FATAL") != std::string::npos;
+                const auto now = std::chrono::steady_clock::now();
+                if (!urgent && now - start > std::chrono::seconds(30) && now - last_write < std::chrono::seconds(30) &&
+                    held.size() < (1u << 20))
+                    continue;
+                for (size_t done = 0; done < held.size();) {
+                    const ssize_t w = write(copy_fds[1], held.data() + done, held.size() - done);
+                    if (w <= 0) return nullptr;
+                    done += size_t(w);
+                }
+                const auto took = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - now).count();
+                last_write = std::chrono::steady_clock::now();
+                const size_t bytes = held.size();
+                held.clear();
+                if (took > 20) {
+                    char note[96];
+                    held.append(note, size_t(std::snprintf(note, sizeof note, "[log] writing %zu bytes to the file took %.0f ms\n", bytes, took)));
+                }
+            }
+            return nullptr;
+        }, nullptr);
+        if (rc != 0) dup2(file, fd);  // no thread: straight to the file again
+        else pthread_detach(writer);
+    }
+    return;
+#endif
 #if defined(SDL_PLATFORM_SWITCH)
     // No console and no pipes on Horizon: stderr goes straight to the file
     // (line buffered, so a crash keeps everything before it).
